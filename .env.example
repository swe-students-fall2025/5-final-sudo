# MongoDB Configuration
MONGO_URI=mongodb://mongodb:27017
MONGO_DB_NAME=dockeeper
SECRET_KEY=dev-change-me

# Reminder Service Configuration
REMINDER_INTERVAL_SECONDS=60

# Email Configuration (Brevo)
# use "brevo" for real email sending requires api key and sender email
# use "mock" for mock email sending
EMAIL_MODE=mock 
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=DocKeeper

# Web App: Base URL for verification links (IMPORTANT for deployment)
# Local: http://localhost:8000
APP_BASE_URL=http://localhost:8000